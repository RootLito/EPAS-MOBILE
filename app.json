{
  "expo": {
    "name": "EPAS",
    "slug": "bfar-eps",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bfareps",
    "userInterfaceStyle": "automatic",
    "updates": {
      "url": "https://u.expo.dev/2203dc43-39bb-49d1-bd5f-a7cea56d75a1"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.bfar.eps",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bfar.eps",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class androidx.work.impl.WorkDatabase* { *; }\n-keep class androidx.work.** { *; }",
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow BFAR EPS to access your camera for attendance photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2203dc43-39bb-49d1-bd5f-a7cea56d75a1"
      }
    }
  }
}
